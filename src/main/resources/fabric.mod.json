{
	"schemaVersion": 1,
	"id": "hungrycows",
	"version": "${version}",
	"name": "Hungry Cows",
	"description": "Making cows eat grass to regenerate their milk giving abilities and letting milk reduce the player's hunger. ",
	"authors": [
		"pnku"
	],
	"contact": {
		"email": "contact@pnku.de",
		"homepage": "https://pnku.de",
		"sources": "https://github.com/pnk2u/hungrycows",
		"issues": "https://github.com/pnk2u/hungrycows/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.pnku.hungrycows.HungryCows"
		],
		"client": [
			"de.pnku.hungrycows.HungryCowsClient"
		],
		"jade": [
			"de.pnku.hungrycows.jade.HungryCowsPlugin"
		]
	},
	"accessWidener": "hungrycows.accesswidener",
	"mixins": [
		"hungrycows.mixins.json",
		{
			"config": "hungrycows.client.mixins.json" ,
			"environment": "client"
		},
		{
			"config": "hungrycows.client.model.mixins.json" ,
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.10",
		"minecraft": ">=1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"nutritiousmilk": "*"
	}
}
