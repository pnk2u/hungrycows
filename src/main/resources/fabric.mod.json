{
	"schemaVersion": 1,
	"id": "hungrycows",
	"version": "${mod_version}",
	"name": "Hungry Cows",
	"description": "§4Cows§r/§cMooshrooms§r now eat §2Grass§r/§7Mycelium§r/§aplants§r to regenerate their §fMilkability§r and §fMilk§r functions as food.\n Also adding several other related features like feeding Cows for Milk or Dispensers being able to milk Cows and lots of customizability.",
	"authors": [
		"pnku"
	],
	"contact": {
		"email": "contact@pnku.de",
		"homepage": "https://www.pnku.de",
		"sources": "https://github.com/pnk2u/hungrycows",
		"issues": "https://github.com/pnk2u/hungrycows/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.pnku.hungrycows.HungryCows"
		],
		"client": [
			"de.pnku.hungrycows.HungryCowsClient"
		],
		"jade": [
			"de.pnku.hungrycows.jade.HungryCowsPlugin"
		]
	},
	"accessWidener": "hungrycows.accesswidener",
	"mixins": [
		"hungrycows.mixins.json",
		{
			"config": "hungrycows.client.mixins.json" ,
			"environment": "client"
		},
		{
			"config": "hungrycows.client.model.mixins.json" ,
			"environment": "client"
		},
		{
			"config": "hungrycows.compat.vanillacowvariants.mixins.json",
			"environment": "client"
		},
		{
			"config": "hungrycows.goatversioncompat.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": [">${minecraft_version_0} <${minecraft_version_1}"],
		"java": ">=21",
		"fabric-api": "*",
		"owo": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.lieonlion.dev"
			}
		},
		"mc-publish": {
			"modrinth": "6aOUwIa8",
			"curseforge": "1058451",
			"dependencies": [
				"fabric-api(required)#(ignore)"
			]
		}
	}
