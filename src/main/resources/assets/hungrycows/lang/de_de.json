  "config.jade.plugin_hungrycows.edible_block": "Block-Fressbarkeit",
  "config.jade.plugin_hungrycows.edible_block_desc": ["Zeigt an, ob ein Block von ",{"translate": "hungrycows.Cows"}, "n/", {"translate": "hungrycows.Mooshrooms"}, "/", {"translate": "hungrycows.Goats"}, "/", {"translate": "hungrycows.Sheep"},"n gefressen werden kann."],
  "config.jade.plugin_hungrycows.milkable_desc": ["Zeigt an, ob eine ",{"translate": "hungrycows.cow_slash_mooshroom"}, "/", {"translate": "entity.minecraft.goat"}," gemolken werden kann."],
  "config.jade.plugin_hungrycows.feedable_desc": ["Zeigt an, ob eine ",{"translate": "hungrycows.cow_slash_mooshroom"}, "/", {"translate": "entity.minecraft.goat"}," oder ein ",{"translate": "entity.minecraft.sheep"}," gefüttert werden kann, um ihre ", {"translate": "hungrycows.Milkability"}, "/", {"translate": "hungrycows.Shearability"}, " wiederherzustellen."],
