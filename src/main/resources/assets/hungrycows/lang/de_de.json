    ")"
  ],
  "text.config.hungrycows.option.blockEatSettings.grassEatProbability": "Wahrscheinlichkeit zu Grasen",
  "text.config.hungrycows.option.blockEatSettings.grassEatProbability.tooltip": [
    "Die Wahrscheinlichkeit, dass eine ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " einen ",

    {"translate": "hungrycows.grass_slash_mycelium_bold"},

    ") frisst, um ihre milchgebenden Fähigkeiten zu regenerieren.\nWerte von 0 (sehr unwahrscheinlich) bis 3 (Höchstwert) sind einsetzbar.\nDer voreingestellte Wert ist 1.0, was dafür sorgt, dass eine ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " circa ein bis zweimal pro Tag grast."
  ],
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatGrowthAmount": "Jungtierwachstum durch Grasen",
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatGrowthAmount.tooltip": [
    "Die Anzahl der Sekunden, die ein ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    "jungtier schneller aufwächst, wenn es ",

    {"translate": "hungrycows.grass_slash_mycelium_bold"},

    " frisst.\nDer voreingestellte Wert sind 60 Sekunden oder 5% der Gesamtdauer (20 Minuten), die das Aufwachsen benötigt.\nSchafe im Hauptspiel benutzen den gleichen Wert (60s)."
  ],
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatHealAmount": "Heilung durch Grasen",
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatHealAmount.tooltip": [
    "Die Menge an Gesundheitspunkten, die eine ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " wiederherstellt, wenn sie ",

    {"translate": "hungrycows.grass_slash_mycelium_bold"},

    " frisst.\nDer voreingestellte Wert ist 1 Gesundheitspunkt (½ §4❤§r), was 10% der gesamten Gesundheitspunkte (10) einer ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"}, " sind."
  ],
  "text.config.hungrycows.category.milkabilitySettings.tooltip": [
    "Diese Einstellungen betreffen ",

    {"translate": "hungrycows.Cows", "bold": true}, ", ", {"translate": "hungrycows.Mooshrooms", "bold": true}, " and ", {"translate": "hungrycows.Goats", "bold": true},
    ".\nAuch das Benutzen einer Schüssel auf einen ",
    {"translate": "entity.minecraft.mooshroom", "color": "#A8212E", "bold": true},", um ",
    {"translate": "item.minecraft.mushroom_stew"}, " zu erhalten, zählt als \"§oMelken§r\".\nVoreingestellt ist, dass",
    {"translate": "hungrycows.Sheep"}, "§r (", {"translate": "hungrycows.Wool"}, ") auch diese Einstellungen nutzen, siehe §l§Schafeinstellungen§r."
  ],
  "text.config.hungrycows.option.milkabilitySettings.secondsUntilFeedabilityRegain": "Pause nach Fütterung",
  "text.config.hungrycows.option.milkabilitySettings.secondsUntilFeedabilityRegain.tooltip": ["Die Anzahl an Sekunden, die du warten musst, bis ein Tier wieder fütterbar wird.\nDas bezieht sich speziell auf das Füttern, um die ", {"translate": "hungrycows.Milkability_italic"}, "/", {"translate": "hungrycows.Shearability_italic"}, "wiederherzustellen."],
  "text.config.hungrycows.category.milkabilitySettings.feedSettings": ["Fütterbare Items"],
  "text.config.hungrycows.category.milkabilitySettings.feedSettings.tooltip": ["Diese Einstellungen lassen dich auswählen, welche Items je Tier zum Anlocken und Füttern verwendet werden können.\nDas bezieht sich speziell auf das Füttern, um die ", {"translate": "hungrycows.Milkability_italic"}, "/", {"translate": "hungrycows.Shearability_italic"}, " oder 2 Gesundheitspunkte (1 §4❤§r) wiederherzustellen."],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.cowFeedableItems": ["§lKuh§rfutter (-> Milch)"],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.mushroomCowFeedableItems": ["§lMooshroom§rfutter (-> Milch/Pilzsuppe)"],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.goatFeedableItems": ["§lZiege§rnfutter (-> Milch)"],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.sheepFeedableItems": ["§lSchaf§rfutter (-> Wolle)"],
  "text.config.hungrycows.option.milkabilitySettings.milkableCowDisplayType": [{"translate": "hungrycows.Milkability"},"s-Modell/Textur anzeigen"],
  "text.config.hungrycows.option.milkabilitySettings.milkableCowDisplayType.tooltip": [
    "Dieses Feature ermöglicht es, eine ", {"translate": "hungrycows.milkable"}, "e ",

    {"translate": "hungrycows.cow_slash_mooshroom"},

    " von einer §nnicht§r ", {"translate": "hungrycows.milkable"}, "en zu unterscheiden.\nWenn die ",

    {"translate": "hungrycows.cow_slash_mooshroom"}, " ", {"translate": "hungrycows.milkable"}, " ist:",

    "\n a) erhöht das Modell die Größe und die Detailliertheit des Euters und\n b) ändert die Textur die ",

    {"text": "Farbe des Euters", "color": "#f7afaf"}, " zu dieser ", {"text": "Farbe eines melkbaren Euters", "color": "#e58f8f"},

    ".\n",{"text": "Diese Einstellung betrifft Ziegen nicht, da sie keine sichtbaren Euter haben.\nZum An-/Ausschalten der Modellveränderungen ist ein Neuladen (§o§lF3§r+§o§lT§r) erforderlich.", "color": "#71586A"},"\n",
    {"text": "Das An-/Ausschalten der Texturveränderungen ist sofort sichtbar.", "color": "#71586A"}
  ],
  "text.config.hungrycows.enum.mCDO.hide_none": "Modell & Textur",
  "text.config.hungrycows.enum.mCDO.hide_model": "Nur Textur anzeigen",
  "text.config.hungrycows.enum.mCDO.hide_texture_and_model": "Nichts anzeigen",
  "text.config.hungrycows.category.sheepSettings": ["Schafeinstellungen"],
  "text.config.hungrycows.category.sheepSettings.tooltip": ["Diese Einstellungen dienen der Einheitlichkeit, da sie sich auf Features beziehen, die nicht von ", {"translate": "hungrycows.Sheep"}, " adaptiert wurden.\nWenn auf \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Aktiviert\" gestellt, nutzen ", {"translate": "hungrycows.Sheep"}, " das jeweilige Feature mit den gleichen Werten entsprechend der Einstellungen für ", {"translate": "hungrycows.Cows"}, " weiter oben."],
  "text.config.hungrycows.option.sheepSettings.isSheepBlockEatToHeal": ["Heilung durch Grasen (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepBlockEatToHeal.tooltip": ["Wenn auf \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Aktiviert\" gestellt, nehmen", {"translate": "hungrycows.Sheep"}, " durch das Fressen von Grasblöcken die gleiche Menge an Gesundheitspunkten wieder auf wie ", {"translate": "hungrycows.Cows"}, ".\nWenn auf \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Deaktiviert\" gestellt, stellen ", {"translate": "hungrycows.Sheep"}, " durch das Grasen keine Gesundheitspunkte wieder her."],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToHeal": ["Heilung durch Fütterung (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToHeal.tooltip": ["Wenn auf \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Aktiviert\" gestellt, nehmen", {"translate": "hungrycows.Sheep"}, " durch das Füttern mit einem Item aus der \"Fütterbare Items\"-Liste für ", {"translate": "hungrycows.Sheep"}, " weiter oben die gleiche Menge an Gesundheitspunkten (2) wieder auf wie ", {"translate": "hungrycows.Cows"}, ".\nWenn auf \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Deaktiviert\" gestellt, stellen ", {"translate": "hungrycows.Sheep"}, " durch das Füttern mit Items keine Gesundheitspunkte wieder her."],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToRegrowWool": ["Nachwachsen der ", {"translate": "hungrycows.Wool"}, " durch Fütterung (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToRegrowWool.tooltip": ["Wenn auf \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Aktiviert\" gestellt, können ", {"translate": "hungrycows.Sheep"}, " ihre ", {"translate": "hungrycows.Wool"}, " auch durch das Füttern mit einem Item aus der \"Fütterbare Items\"-Liste für ", {"translate": "hungrycows.Sheep"}, " weiter oben nachwachsen lassen.\nWenn auf \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Deaktiviert\" gestellt, lassen ", {"translate": "hungrycows.Sheep"}, " ihre ", {"translate": "hungrycows.Wool"}, " nicht mehr durch das Füttern mit Items nachwachsen."],
  "item.hungrycows.milk_bucket.cow": ["§lKuh§rmilcheimer"],
  "item.hungrycows.milk_bucket.mooshroom": ["§lMooshroom§rmilcheimer"],
