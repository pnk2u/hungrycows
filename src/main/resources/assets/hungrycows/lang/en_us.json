  "hungrycows.nutritionValue": "Fill Hunger",
  "hungrycows.nutritionValue.tooltip": ["Amount of food points added to the hunger bar, a fully filled hunger bar consists of 20 food points (10 🍖).\nThe values for vanilla foods range from 1 (like ",{"translate": "item.minecraft.beetroot"}," or ",{"translate": "item.minecraft.dried_kelp"},") to 8 (like ",{"translate": "item.minecraft.cooked_porkchop"}," or ",{"translate": "item.minecraft.pumpkin_pie"},")."],
  "hungrycows.saturationModifier": "Restore Saturation",
  "hungrycows.saturationModifier.tooltip": ["This refers to the hidden stat of saturation which depending on its value lengthens the time until your hunger bar starts depleting.\nThe values for vanilla foods range from 0.1 (like ",{"translate": "tag.item.c.foods.raw_fish"},", ",{"translate": "tag.item.c.foods.cookies"}," or ",{"translate": "tag.item.c.foods.berries"},") to 1.2 (like ",{"translate": "item.minecraft.golden_apple"},"/",{"translate": "item.minecraft.carrot"},")."],
  "hungrycows.feedable_item_ids_1": "Any item IDs added to this list are used to lure and feed ",
  "hungrycows.feedable_item_ids_2": " restoring their ",
  "hungrycows.feedable_item_ids_3": " or one heart (1 §4❤§r).\nBesides this list, item IDs can also be added to the item tag ",
  "hungrycows.feedable_item_ids_4": " by datapacks or other mods.\nBy default, this tag only includes the vanilla item tag ",
  "hungrycows.feedable_item_ids_5": " (contains: ",
