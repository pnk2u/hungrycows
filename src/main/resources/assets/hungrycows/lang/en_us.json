  "modmenu.summaryTranslation.hungrycows": [{"translate": "hungrycows.cows_slash_mooshrooms_bold"}," now eat ",{"translate": "hungrycows.grass_slash_mycelium_bold"}," to regenerate their ", {"translate": "hungrycows.Milkability"}, " and ", {"translate": "hungrycows.Milk"}, " is a food."],
  "modmenu.descriptionTranslation.hungrycows": [{"translate": "hungrycows.cows_slash_mooshrooms_bold"}," now eat ",{"translate": "hungrycows.grass_slash_mycelium_bold"}," to regenerate their ", {"translate": "hungrycows.Milkability"}, " and ", {"translate": "hungrycows.Milk"}, " is a food.\n Also adding several other related features like:\n - Feeding §4", {"translate": "hungrycows.Cows"}, "§r/§c", {"translate": "hungrycows.Mooshrooms"}, "§r or even §f", {"translate": "hungrycows.Goats"}, "§r to restore their ", {"translate": "hungrycows.Milkability"}, "\n - Feeding §l", {"translate": "hungrycows.Sheep"}, "§r to restore their §f", {"translate": "hungrycows.Shearability"}, "§r\n - When being fed or eating blocks, these animals can also regain health and babies can grow up faster\n - Dispensers being able to milk like they can shear\n - Customizable settings for all of the above and more!"],

