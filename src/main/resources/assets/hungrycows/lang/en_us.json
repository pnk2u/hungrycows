  "text.config.hungrycows.category.blockEatSettings": [
    "Block (",

    {"translate": "hungrycows.grass_slash_mycelium_bold"},

    ") Eating"
  ],
  "text.config.hungrycows.option.blockEatSettings.grassEatProbability": "Probability of Eating Blocks",
  "text.config.hungrycows.option.blockEatSettings.grassEatProbability.tooltip": [
    "The probability that a ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " eats a block of ",

    {"translate": "hungrycows.grass_slash_mycelium_bold"},

    " to regenerate its milk giving ability.\nRanges from 0 (very unlikely) to 3 (the maximum), the default value is 1.0 which makes the ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " eat about once to twice a day."
  ],
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatGrowthAmount": "Baby Growth Amount from Eating Blocks",
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatGrowthAmount.tooltip": [
    "How many seconds faster a baby ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " grows up after having eaten a block of ",

    {"translate": "hungrycows.grass_slash_mycelium_bold"},

    ".\nBy default (the same value ", {"translate": "hungrycows.Sheep"}, " use), this is 60 seconds or 5% of the total time (20 minutes) it takes it to grow up."
  ],
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatHealAmount": "Healing from Eating Blocks",
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatHealAmount.tooltip": [
    "How many health points a ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " regains by eating a block of ",

    {"translate": "hungrycows.grass_slash_mycelium_bold"},

    ".\nBy default this value is 1 health point (½ §4❤§r) which is 10% of the total amount of health (10) a ",

    {"translate": "hungrycows.cow_slash_mooshroom_bold"},

    " has."
  ],
  "text.config.hungrycows.category.milkabilitySettings": [{"translate": "hungrycows.Milkability"}],
  "text.config.hungrycows.category.milkabilitySettings.tooltip": [
    "These settings apply to ",

    {"translate": "hungrycows.Cows", "bold": true}, ", ", {"translate": "hungrycows.Mooshrooms", "bold": true}, " and ", {"translate": "hungrycows.Goats", "bold": true},
    ".\nUsing a bowl on a ",{"translate": "entity.minecraft.mooshroom", "color": "#A8212E", "bold": true}," to receive ", {"translate": "item.minecraft.mushroom_stew"}, " counts as \"§omilking§r\" it.\nBy default, §l", {"translate": "hungrycows.Sheep"}, "§r (", {"translate": "hungrycows.Wool"}, ") are also affected, see ",{"translate": "entity.minecraft.sheep", "bold": true, "italic": true},"§l§o (Parity)§r down below."
  ],
  "text.config.hungrycows.option.milkabilitySettings.secondsUntilFeedabilityRegain": "Cooldown between Feeding",
  "text.config.hungrycows.option.milkabilitySettings.secondsUntilFeedabilityRegain.tooltip": ["The amount of seconds that you have to wait for an animal to be feedable again.\nThis refers to the ability to feed an animal to restore their ", {"translate": "hungrycows.Milkability_italic"}, "/", {"translate": "hungrycows.Shearability_italic"}, "."],
  "text.config.hungrycows.category.milkabilitySettings.feedSettings": ["Feedable Items"],
  "text.config.hungrycows.category.milkabilitySettings.feedSettings.tooltip": ["These settings let you customize which exact items can be used to lure and feed each respective animal.\nThis refers to the ability to feed an animal to restore their ", {"translate": "hungrycows.Milkability_italic"}, "/", {"translate": "hungrycows.Shearability_italic"}, " or heal them by 2 health points (1 §4❤§r)."],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.cowFeedableItems": ["Feeding ", {"translate": "hungrycows.Cows", "bold": true}, " (",{"translate": "item.minecraft.milk_bucket"},")"],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.cowFeedableItems.tooltip": [{"translate": "hungrycows.feedable_item_ids_1"}, {"translate": "hungrycows.Cows", "bold": true}, {"translate": "hungrycows.feedable_item_ids_2"}, {"translate": "hungrycows.Milkability_italic"}, {"translate": "hungrycows.feedable_item_ids_3"}, "\"§o#hungrycows:cow_feedable§r\"",{"translate": "hungrycows.feedable_item_ids_4"},"\"§o#minecraft:cow_food§r\"",{"translate": "hungrycows.feedable_item_ids_5"},{"translate": "item.minecraft.wheat"},")."],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.mushroomCowFeedableItems": ["Feeding ", {"translate": "hungrycows.Mooshrooms", "bold": true}, " (",{"translate": "item.minecraft.milk_bucket"},"/",{"translate": "item.minecraft.mushroom_stew"},")"],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.mushroomCowFeedableItems.tooltip": [{"translate": "hungrycows.feedable_item_ids_1"}, {"translate": "hungrycows.Mooshrooms", "bold": true}, {"translate": "hungrycows.feedable_item_ids_2"}, {"translate": "hungrycows.Milkability_italic"}, {"translate": "hungrycows.feedable_item_ids_3"}, "§o#hungrycows:mooshroom_feedable§r", {"translate": "hungrycows.feedable_item_ids_4"}, "\"§o#minecraft:mooshroom_food§r\"", {"translate": "hungrycows.feedable_item_ids_5"},{"translate": "item.minecraft.wheat"},")."],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.goatFeedableItems": ["Feeding ", {"translate": "hungrycows.Goats", "bold": true, "underlined": true}, " (",{"translate": "item.minecraft.milk_bucket"},")"],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.goatFeedableItems.tooltip": [{"translate": "hungrycows.feedable_item_ids_1"}, {"translate": "hungrycows.Goats", "bold": true}, {"translate": "hungrycows.feedable_item_ids_2"}, {"translate": "hungrycows.Milkability_italic"}, {"translate": "hungrycows.feedable_item_ids_3"}, "§o#hungrycows:goat_feedable§r", {"translate": "hungrycows.feedable_item_ids_4"}, "\"§o#minecraft:goat_food§r\"", {"translate": "hungrycows.feedable_item_ids_5"},{"translate": "item.minecraft.wheat"},")."],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.sheepFeedableItems": ["Feeding ", {"translate": "hungrycows.Sheep", "bold": true, "underlined": true}, " (", {"translate": "hungrycows.Wool"}, ")"],
  "text.config.hungrycows.option.milkabilitySettings.feedSettings.sheepFeedableItems.tooltip": [{"translate": "hungrycows.feedable_item_ids_1"}, {"translate": "hungrycows.Sheep", "bold": true}, {"translate": "hungrycows.feedable_item_ids_2"}, {"translate": "hungrycows.Shearability_italic"}, {"translate": "hungrycows.feedable_item_ids_3"}, "§o#hungrycows:sheep_feedable§r", {"translate": "hungrycows.feedable_item_ids_4"}, "\"§o#minecraft:sheep_food§r\"", {"translate": "hungrycows.feedable_item_ids_5"},{"translate": "item.minecraft.wheat"},")."],
  "text.config.hungrycows.option.milkabilitySettings.milkableCowDisplayType": ["Show Custom ", {"translate": "hungrycows.Milkable"}, " Model/Texture"],
  "text.config.hungrycows.option.milkabilitySettings.milkableCowDisplayType.tooltip": [
    "This feature allows you to visually distinguish a ", {"translate": "hungrycows.milkable"}, " ",

    {"translate": "hungrycows.cow_slash_mooshroom"},

    " from one that can't be milked yet.\nWhen the ",

    {"translate": "hungrycows.cow_slash_mooshroom"},

    " is ", {"translate": "hungrycows.milkable"}, ":\n a) the model increases the size and details of the udder and\n b) the texture changes the ",

    {"text": "color of an udder", "color": "#f7afaf", "italic": true}, " to this ", {"text": "color of a ", "color": "#e58f8f", "italic": true}, {"translate": "hungrycows.milkable", "color": "white", "italic": true},{"text": " udder", "color": "#e58f8f", "italic": true},

    ".\n",{"text": "This setting does not apply to goats as they do not have a visible udder.\nEn-/Disabling the model changes requires a reload (§o§lF3§r+§o§lT§r) to take effect.", "color": "#71586A"},"\n",
    {"text": "En-/Disabling the texture changes takes effect immediately.", "color": "#71586A"}
  ],
  "text.config.hungrycows.enum.mCDO.hide_none": "Show Model & Texture",
  "text.config.hungrycows.enum.mCDO.hide_model": "Show Only Texture",
  "text.config.hungrycows.enum.mCDO.hide_texture_and_model": "Show Neither",
  "text.config.hungrycows.category.sheepSettings": [{"translate": "entity.minecraft.sheep", "bold": true}, " (Parity)"],
  "text.config.hungrycows.category.sheepSettings.tooltip": ["These settings exist for parity as they refer to features that aren't adapted from ", {"translate": "hungrycows.Sheep"}, " themselves.\nIf set to \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Enabled\" ", {"translate": "hungrycows.Sheep"}, " use the feature with the same values set above for ", {"translate": "hungrycows.Cows"}, "."],
  "text.config.hungrycows.option.sheepSettings.isSheepBlockEatToHeal": ["Healing from Eating Blocks (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepBlockEatToHeal.tooltip": ["If set to \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Enabled\" ", {"translate": "hungrycows.Sheep"}, " regain the same amount of health as ", {"translate": "hungrycows.Cows"}, " by eating a block of Grass.\nIf set to \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Disabled\" ", {"translate": "hungrycows.Sheep"}, " revert to the vanilla behavior of not regaining health at all."],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToHeal": ["Healing from Being Fed Food (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToHeal.tooltip": ["If set to \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Enabled\" ", {"translate": "hungrycows.Sheep"}, " regain the same amount of health (2) as ", {"translate": "hungrycows.Cows"}, " by being fed an item specified in the \"Feedable Items\" list for ", {"translate": "hungrycows.Sheep"}, " above.\nIf set to \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Disabled\" ", {"translate": "hungrycows.Sheep"}, " revert to the vanilla behavior of not regaining health at all."],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToRegrowWool": ["Regrowing ", {"translate": "hungrycows.Wool"}, " from Being Fed Food (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToRegrowWool.tooltip": ["If set to \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Enabled\" ", {"translate": "hungrycows.Sheep"}, " can also regrow their wool by being fed an item specified in the \"Feedable Items\" list for ", {"translate": "hungrycows.Sheep"}, " above.\nIf set to \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Disabled\" ", {"translate": "hungrycows.Sheep"}, " revert to the vanilla behavior of not regrowing ", {"translate": "hungrycows.Wool"}, " by being fed at all."],
