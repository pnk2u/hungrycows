  "text.config.hungrycows.option.sheepSettings.isSheepBlockEatToHeal": ["Cura ao Comer Blocos (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepBlockEatToHeal.tooltip": ["Se definido como \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Habilitado\" as ", {"translate": "hungrycows.Sheep"}, " recuperarão a mesma quantidade de vida que as ", {"translate": "hungrycows.Cows"}, " ao comer um bloco de Grama.\nSe definido como \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Desabilitado\" as ", {"translate": "hungrycows.Sheep"}, " voltarão ao comportamento padrão de não recuperar vida."],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToHeal": ["Cura ao Ser Alimentada (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToHeal.tooltip": ["Se definido como \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Habilitado\" as ", {"translate": "hungrycows.Sheep"}, " recuperarão a mesma quantidade de vida (2) que as ", {"translate": "hungrycows.Cows"}, " ao serem alimentadas com um item especificado na lista de \"Itens para Alimentação\" das ", {"translate": "hungrycows.Sheep"}, " acima.\nSe definido como \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Desabilitado\" as ", {"translate": "hungrycows.Sheep"}, " voltarão ao comportamento padrão de não recuperar vida."],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToRegrowWool": ["Regenerar ", {"translate": "hungrycows.Wool"}, " ao Ser Alimentada (", {"translate": "entity.minecraft.sheep"}, ")"],
  "text.config.hungrycows.option.sheepSettings.isSheepFeedToRegrowWool.tooltip": ["Se definido como \"", {"text": "[", "color": "gray"}, {"text": "✔", "color": "#28FFBF"}, {"text": "]", "color": "gray"}, " Habilitado\" as ", {"translate": "hungrycows.Sheep"}, " também poderão regenerar sua lã ao serem alimentadas com um item especificado na lista de \"Itens para Alimentação\" das ", {"translate": "hungrycows.Sheep"}, " acima.\nSe definido como \"", {"text": "[", "color": "gray"}, {"text": "❌", "color": "#EB1D36"}, {"text": "]", "color": "gray"}, " Desabilitado\" as ", {"translate": "hungrycows.Sheep"}, " voltarão ao comportamento padrão de não regenerar ", {"translate": "hungrycows.Wool"}, " ao serem alimentadas."],
