  "hungrycows.nutritionValue": "Sacia Fome",
  "hungrycows.nutritionValue.tooltip": ["Quantidade de pontos de fome adicionados à barra de fome, sendo que uma barra totalmente cheia consiste em 20 pontos (10 🍖).\nOs valores dos alimentos padrão variam de 1 (como ",{"translate": "item.minecraft.beetroot"}," ou ",{"translate": "item.minecraft.dried_kelp"},") a 8 (como ",{"translate": "item.minecraft.cooked_porkchop"}," ou ",{"translate": "item.minecraft.pumpkin_pie"},")."],
  "hungrycows.saturationModifier": "Restaura Saturação",
