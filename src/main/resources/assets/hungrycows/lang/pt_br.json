  "text.config.hungrycows.option.milkabilitySettings.feedSettings.cowFeedableItems.tooltip": [{"translate": "hungrycows.feedable_item_ids_1"}, {"translate": "hungrycows.Cows", "bold": true}, {"translate": "hungrycows.feedable_item_ids_2"}, {"translate": "hungrycows.Milkability_italic"}, {"translate": "hungrycows.feedable_item_ids_3"}, "\"§o#hungrycows:cow_feedable§r\"",{"translate": "hungrycows.feedable_item_ids_4"},"\"§o#minecraft:cow_food§r\"",{"translate": "hungrycows.feedable_item_ids_5"},{"translate": "item.minecraft.wheat"},")."],
