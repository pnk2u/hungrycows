  "text.config.hungrycows.option.milkabilitySettings.milkableCowDisplayType": ["Mostrar Modelo/Textura Personalizada de ", {"translate": "hungrycows.Milkable"}],
  "text.config.hungrycows.option.milkabilitySettings.milkableCowDisplayType.tooltip": [
    "Este recurso permite distinguir visualmente uma ", {"translate": "hungrycows.cow_slash_mooshroom"}, " ",
    {"translate": "hungrycows.milkable"}, " daquelas que ainda não podem ser ordenhadas.\nQuando a ",
