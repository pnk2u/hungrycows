  "text.config.hungrycows.option.blockEatSettings.grassEatProbability": "Probabilidade de Comer Blocos",
  "text.config.hungrycows.option.blockEatSettings.grassEatProbability.tooltip": [
    "A probabilidade de uma ",
    {"translate": "hungrycows.cow_slash_mooshroom_bold"},
    " comer um bloco de ",
    {"translate": "hungrycows.grass_slash_mycelium_bold"},
    " para regenerar sua capacidade de produzir leite.\nVaria de 0 (muito improvável) a 3 (máximo). O valor padrão é 1.0, o que faz com que a ",
    {"translate": "hungrycows.cow_slash_mooshroom_bold"},
    " coma cerca de uma a duas vezes por dia."
  ],
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatGrowthAmount": "Crescimento do Bebê ao Comer Blocos",
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatGrowthAmount.tooltip": [
    "Quantos segundos um bezerro ",
    {"translate": "hungrycows.cow_slash_mooshroom_bold"},
    " crescerá mais rápido após comer um bloco de ",
    {"translate": "hungrycows.grass_slash_mycelium_bold"},
    ".\nPor padrão (o mesmo valor usado por ", {"translate": "hungrycows.Sheep"}, "), isso é 60 segundos ou 5% do tempo total (20 minutos) necessário para crescer completamente."
  ],
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatHealAmount": "Cura ao Comer Blocos",
  "text.config.hungrycows.option.blockEatSettings.cowBlockEatHealAmount.tooltip": [
    "Quantos pontos de vida uma ",
    {"translate": "hungrycows.cow_slash_mooshroom_bold"},
    " recupera ao comer um bloco de ",
    {"translate": "hungrycows.grass_slash_mycelium_bold"},
    ".\nPor padrão, esse valor é 1 ponto de vida (½ §4❤§r), o que equivale a 10% do total de vida (10) de uma ",
    {"translate": "hungrycows.cow_slash_mooshroom_bold"},
    "."
  ],
  "text.config.hungrycows.category.milkabilitySettings": [{"translate": "hungrycows.Milkability"}],
